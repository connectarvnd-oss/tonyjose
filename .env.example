# ─── Core ──────────────────────────────────────────────────────────────────
# Public URL of the site, no trailing slash. Used for links, OAuth and Stripe redirects.
SITE_URL=http://localhost:3000
DATABASE_URL=postgres://tony:tony@localhost:5432/tony
# Set to true for managed Postgres that requires TLS (Supabase, Neon, RDS…)
DATABASE_SSL=false

# 32 random bytes, base64. Encrypts Google OAuth tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# At least 32 random characters. Signs clients' "manage booking" links.
APP_SECRET=
# Shared secret for /api/cron (sent as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Fallback address for Tony's notifications (can also be set in Admin → Settings).
ADMIN_NOTIFICATION_EMAIL=

# ─── Google Calendar (OAuth 2.0 web client) ─────────────────────────────────
# Redirect URI to register: ${SITE_URL}/api/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Payments ───────────────────────────────────────────────────────────────
# stripe | test   (test = simulated checkout, refused in production unless ALLOW_TEST_PAYMENTS=true)
PAYMENT_PROVIDER=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_TEST_PAYMENTS=false

# ─── Email ──────────────────────────────────────────────────────────────────
# resend | console   (console = log only, nothing is delivered)
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. bookings@tonyjose.com
EMAIL_FROM=

# ─── Optional spam protection (Cloudflare Turnstile) ────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
